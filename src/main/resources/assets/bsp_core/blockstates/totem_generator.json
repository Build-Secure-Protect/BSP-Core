   }
  },
  {
   "when": {
    "south": "true"
   },
   "apply": {
    "model": "bsp_core:block/totem_generator_join",
    "y": 180
   }
  },
  {
   "when": {
    "south": "false"
   },
   "apply": {
    "model": "bsp_core:block/totem_generator_ports",
    "y": 180
   }
  },
  {
   "when": {
    "west": "true"
   },
   "apply": {
    "model": "bsp_core:block/totem_generator_join",
    "y": 270
   }
  },
  {
   "when": {
    "west": "false"
   },
   "apply": {
    "model": "bsp_core:block/totem_generator_ports",
    "y": 270
   }
